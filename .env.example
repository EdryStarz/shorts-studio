ENVIRONMENT=development
POSTGRES_PASSWORD=choose-a-local-password
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MULTIMODAL_ANALYSIS_ENABLED=true
SIGNAL_BUCKET_SECONDS=1.0
LOCAL_DIRECTOR_ENABLED=true
# The desktop build sets this to true and downloads the official 2.5 GB Q4 model in background.
LOCAL_DIRECTOR_AUTO_DOWNLOAD=false
LOCAL_DIRECTOR_REPO=Qwen/Qwen3-4B-GGUF
LOCAL_DIRECTOR_FILENAME=Qwen3-4B-Q4_K_M.gguf
MAX_UPLOAD_BYTES=10737418240
REAL_PUBLISHING_ENABLED=false
CHANNEL_WATCH_ENABLED=true
CHANNEL_WATCH_URL=https://www.youtube.com/@example/videos
CHANNEL_WATCH_INTERVAL_SECONDS=1800
CHANNEL_WATCH_LOOKBACK_VIDEOS=12
CHANNEL_WATCH_MAX_VIDEOS_PER_CYCLE=1
CHANNEL_WATCH_BROWSER=edge
CHANNEL_WATCH_AUTO_QUEUE=true
CHANNEL_WATCH_AUTO_PUBLISH_TIKTOK=false
YOUTUBE_MAX_DOWNLOAD_HEIGHT=1080
EXPORT_CRF=16
EXPORT_MAX_WEBCAM_UPSCALE=4.0
EXPORT_PREFER_SOURCE_FPS=true
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Optional official platform credentials. Keep empty for local MVP/dry run.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/oauth/youtube/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/oauth/tiktok/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/oauth/instagram/callback
